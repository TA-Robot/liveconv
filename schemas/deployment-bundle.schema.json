{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TA-Robot/liveconv/schemas/deployment-bundle.schema.json",
  "title": "liveconv immutable deployment bundle",
  "description": "Gateway-private profile registry plus the exact public-safe manifest projection. Cross-document identities and canonical hashes are enforced by scripts/validate-deployment-bundle.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "created_at",
    "bundle_revision",
    "protocol_version",
    "gateway_profile_registry",
    "authorization_registry_revision",
    "authorization_records",
    "public_manifest",
    "consumer_contract"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "bundle_id": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string", "format": "date-time" },
    "bundle_revision": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of canonical UTF-8 JSON with ASCII escaping, sorted keys, compact separators, and both bundle_revision fields omitted."
    },
    "protocol_version": { "const": 1 },
    "gateway_profile_registry": {
      "type": "object",
      "description": "Gateway-private full registry. It is separately validated against model-profile-registry.schema.json and is never returned by the public manifest endpoint.",
      "additionalProperties": false,
      "required": ["schema_version", "profiles"],
      "properties": {
        "schema_version": { "const": 1 },
        "profiles": { "type": "array", "minItems": 1, "maxItems": 32 }
      }
    },
    "authorization_records": {
      "type": "array",
      "description": "Gateway-private approved records. The public manifest exposes only each canonical record digest.",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/authorizationRecord" }
    },
    "authorization_registry_revision": { "$ref": "#/$defs/sha256" },
    "public_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "bundle_id",
        "bundle_revision",
        "protocol_version",
        "transport_scope",
        "max_sessions",
        "variants"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "bundle_id": { "$ref": "#/$defs/id" },
        "bundle_revision": { "$ref": "#/$defs/sha256" },
        "protocol_version": { "const": 1 },
        "transport_scope": { "const": "loopback-ssh" },
        "max_sessions": { "const": 1 },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    },
    "consumer_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_manifest_path",
        "public_manifest_authentication",
        "authorization_registry_source",
        "canonicalization",
        "gateway_activation",
        "whole_bundle_mismatch",
        "variant_mismatch",
        "terminal_must_match",
        "extension_must_match"
      ],
      "properties": {
        "public_manifest_path": { "const": "/v1/deployment-manifest" },
        "public_manifest_authentication": { "const": "bearer" },
        "authorization_registry_source": {
          "const": "operator-controlled-private-file"
        },
        "canonicalization": {
          "const": "json-utf8-ascii-sort-keys-compact-excluding-bundle-revision"
        },
        "gateway_activation": { "const": "validate-before-atomic-swap" },
        "whole_bundle_mismatch": { "const": "reject-load-native-only" },
        "variant_mismatch": { "const": "disable-variant" },
        "terminal_must_match": { "const": true },
        "extension_must_match": { "const": true }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authorizationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_sha256",
        "variant_id",
        "family_id",
        "profile_id",
        "status",
        "scope",
        "authorization_owner",
        "retention_policy",
        "deletion_path",
        "source_material_sha256",
        "source_manifest_sha256",
        "terms_sha256",
        "lineage_manifest_sha256",
        "reviewed_at",
        "expires_at",
        "attribution_state",
        "notice_state"
      ],
      "properties": {
        "record_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 of the canonical record with record_sha256 omitted."
        },
        "variant_id": { "$ref": "#/$defs/id" },
        "family_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^vc\\.[a-z0-9][a-z0-9.-]*\\.v[0-9]+$"
        },
        "status": { "const": "approved" },
        "scope": { "const": "personal-evaluation" },
        "authorization_owner": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "retention_policy": { "const": "delete-on-expiry-or-revocation" },
        "deletion_path": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1024,
          "pattern": "^/[^\\r\\n]+$"
        },
        "source_material_sha256": { "$ref": "#/$defs/sha256" },
        "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "terms_sha256": { "$ref": "#/$defs/sha256" },
        "lineage_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "expires_at": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        },
        "attribution_state": { "enum": ["satisfied", "not-required"] },
        "notice_state": {
          "enum": [
            "satisfied",
            "not-required",
            "not-required-for-personal-evaluation"
          ]
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "family_id",
        "display_order",
        "display_name",
        "target_presentation",
        "lane",
        "invocation_mode",
        "profile_id",
        "profile_hash",
        "configuration_hash",
        "pack_id",
        "promotion_evidence_sha256",
        "authorization_record_sha256",
        "variant_manifest_sha256"
      ],
      "properties": {
        "variant_id": { "$ref": "#/$defs/id" },
        "family_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$"
        },
        "display_order": { "type": "integer", "minimum": 1, "maximum": 32 },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^/\\\\\\r\\n]+$"
        },
        "target_presentation": {
          "enum": [
            "youthful-feminine",
            "bright-youthful-feminine",
            "soft-youthful-feminine",
            "relaxed-youthful-feminine"
          ]
        },
        "lane": { "const": "voice-conversion" },
        "invocation_mode": { "enum": ["live", "buffered_end"] },
        "profile_id": {
          "type": "string",
          "pattern": "^vc\\.[a-z0-9][a-z0-9.-]*\\.v[0-9]+$"
        },
        "profile_hash": { "$ref": "#/$defs/sha256" },
        "configuration_hash": { "$ref": "#/$defs/sha256" },
        "pack_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        },
        "promotion_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "authorization_record_sha256": { "$ref": "#/$defs/sha256" },
        "variant_manifest_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 of the canonical variant object with variant_manifest_sha256 omitted."
        }
      }
    }
  }
}
