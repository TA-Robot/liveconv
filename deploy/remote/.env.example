# Public DNS A/AAAA records must resolve to this host. Do not include a scheme,
# path, wildcard, or port.
LIVECONV_PUBLIC_HOST=
LIVECONV_ACME_EMAIL=

# Absolute paths outside the repository. The token file must contain one random,
# visible-ASCII token with at least 32 bytes and 16 distinct characters. It must
# be readable by numeric GID 10001 (recommended deploy-user owner and mode 0440).
LIVECONV_API_TOKEN_FILE=
LIVECONV_MODEL_ARTIFACT_DIR=

# One or more comma-separated exact origins. Each extension ID is exactly 32
# lowercase characters in the a-p range.
LIVECONV_ALLOWED_ORIGINS=

# Optional bounded Gateway settings.
LIVECONV_TICKET_TTL_SECONDS=30
LIVECONV_ATTACH_TIMEOUT_SECONDS=5
LIVECONV_INGRESS_BUDGET_MS=500
LIVECONV_MAX_SESSIONS=64
LIVECONV_SESSION_LIFETIME_SECONDS=1800
LIVECONV_REQUEST_CACHE_MAX=1024
LIVECONV_SEND_TIMEOUT_SECONDS=1

# Required only with compose.profile-registry.yaml.
LIVECONV_PROFILE_CONFIG_FILE=
