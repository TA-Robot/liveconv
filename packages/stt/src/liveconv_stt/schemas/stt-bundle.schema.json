{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liveconv.invalid/schemas/stt-bundle.schema.json",
  "title": "liveconv STT evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "engine_revision",
    "model_revision",
    "model_artifact_sha256",
    "audio_artifact",
    "transcript",
    "normalized_transcript",
    "exact_entities",
    "stt_evidence"
  ],
  "properties": {
    "schema_version": { "const": "liveconv-stt-bundle-v1" },
    "role": { "enum": ["source", "output"] },
    "engine_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}==[0-9]+(?:\\.[0-9]+){1,3}[A-Za-z0-9_.+-]*$"
    },
    "model_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/+-]{0,191}@sha256:[0-9a-f]{64}$"
    },
    "model_artifact_sha256": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "audio_artifact": { "$ref": "#/$defs/audio_artifact" },
    "transcript": { "type": "string", "maxLength": 200000 },
    "normalized_transcript": { "type": "string", "maxLength": 200000 },
    "exact_entities": { "$ref": "#/$defs/exact_entities" },
    "stt_evidence": { "$ref": "#/$defs/stt_evidence" }
  },
  "$defs": {
    "audio_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes",
        "sample_rate_hz",
        "channels",
        "sample_width_bytes",
        "frame_count",
        "duration_seconds"
      ],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "sample_rate_hz": { "type": "integer", "minimum": 8000, "maximum": 192000 },
        "channels": { "const": 1 },
        "sample_width_bytes": { "const": 2 },
        "frame_count": { "type": "integer", "minimum": 1 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 600 }
      }
    },
    "exact_entities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "normalized_expected", "matched", "missing", "exact_match_rate"],
      "properties": {
        "expected": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "normalized_expected": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "matched": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "missing": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "exact_match_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "stt_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_revision",
        "decode_config",
        "language",
        "transcribed_at",
        "normalization_revision"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model_revision": { "type": "string", "minLength": 1 },
        "decode_config": { "type": "object", "minProperties": 1 },
        "language": { "enum": ["ja", "ja-JP"] },
        "transcribed_at": { "type": "string", "format": "date-time" },
        "normalization_revision": { "const": "liveconv-jp-nfkc-kana-v1" }
      }
    }
  }
}
