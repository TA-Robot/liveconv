{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TA-Robot/liveconv/packages/evaluation/schemas/streaming-lane.schema.json",
  "title": "liveconv render-bound streaming operations evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "evaluator",
    "artifacts",
    "policy",
    "streaming_operations",
    "evaluation_lane",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "report_type": { "const": "streaming-operations-evidence" },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "revision", "runtime_lock"],
      "properties": {
        "implementation": { "type": "string", "minLength": 1 },
        "revision": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}==[0-9]+(?:\\.[0-9]+){1,3}|[A-Za-z0-9][A-Za-z0-9_.:/+\\-]{0,191}@sha256:[0-9a-f]{64})$"
        },
        "runtime_lock": { "$ref": "#/$defs/runtime_lock" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "output_sha256"],
      "properties": {
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "output_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "status"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "status": { "enum": ["proposed", "approved"] }
      }
    },
    "streaming_operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_sha256", "checks"],
      "properties": {
        "trace_sha256": { "$ref": "#/$defs/sha256" },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bounded_queues",
            "stale_generation_discard",
            "interruption_cancel"
          ],
          "properties": {
            "bounded_queues": { "type": "boolean" },
            "stale_generation_discard": { "type": "boolean" },
            "interruption_cancel": { "type": "boolean" }
          }
        }
      }
    },
    "evaluation_lane": { "$ref": "#/$defs/lane" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runtime_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "sha256", "packages"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "packages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "evidence"],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "\\S" }
        }
      }
    }
  }
}
