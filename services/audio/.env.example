# Replace every placeholder before running. Do not commit real credentials.
LIVECONV_API_TOKEN=replace-with-a-long-random-development-token
LIVECONV_ALLOWED_ORIGINS=chrome-extension://replace-with-extension-id

# Development binds to loopback. TLS belongs at the reviewed ingress boundary.
LIVECONV_BIND_HOST=127.0.0.1
LIVECONV_BIND_PORT=8765

# Optional overrides.
LIVECONV_PROFILE_CONFIG=../../config/model-profiles.json
LIVECONV_ROSTER_CONFIG=../../config/model-roster.json
# Required only for explicitly reviewed technical-model trials.
LIVECONV_ALLOW_TECHNICAL_PROFILES=0
LIVECONV_TICKET_TTL_SECONDS=30
LIVECONV_ATTACH_TIMEOUT_SECONDS=5
LIVECONV_INGRESS_BUDGET_MS=500
LIVECONV_MAX_SESSIONS=64
LIVECONV_SESSION_LIFETIME_SECONDS=1800
LIVECONV_REQUEST_CACHE_MAX=1024
